---
/**
 * StarField Component
 * Generates an animated starfield background with twinkling stars
 */

interface Props {
  starCount?: number;
}

const { starCount = 150 } = Astro.props;

// Generate random stars
const stars = Array.from({ length: starCount }, () => ({
  x: Math.random() * 100,
  y: Math.random() * 100,
  size: Math.random() < 0.7 ? 'sm' : Math.random() < 0.9 ? 'md' : 'lg',
  twinkle: Math.random() < 0.3 ? 'slow' : Math.random() < 0.6 ? 'medium' : 'fast',
  delay: Math.random() * 4
}));
---

<div class="star-field star-field-dark" id="star-field">
  {stars.map((star) => (
    <div
      class={`star star-${star.size} star-twinkle-${star.twinkle}`}
      style={`left: ${star.x}%; top: ${star.y}%; animation-delay: ${star.delay}s;`}
    />
  ))}
</div>

<script>
  // No parallax - starfield stays fixed behind all content
</script>

<style>
  /* Import effects styles */
  .star-field {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    transition: background 0.3s ease;
  }
</style>
