---
/**
 * StarField Component
 * Animated starfield with deterministic star positions (seeded PRNG).
 * Same star layout across navigations — no flicker. `aria-hidden` to hide from AT.
 */

interface Props {
  starCount?: number;
  seed?: number;
}

const { starCount = 150, seed = 42 } = Astro.props;

// mulberry32 — small, fast, seeded PRNG. Yields identical sequence for identical seed.
function makeRng(initial: number) {
  let s = initial >>> 0;
  return () => {
    s = (s + 0x6D2B79F5) >>> 0;
    let t = s;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rng = makeRng(seed);
const sizePick = (r: number) => (r < 0.7 ? 'sm' : r < 0.9 ? 'md' : 'lg');
const twinklePick = (r: number) => (r < 0.3 ? 'slow' : r < 0.6 ? 'medium' : 'fast');

const stars = Array.from({ length: starCount }, () => ({
  x: rng() * 100,
  y: rng() * 100,
  size: sizePick(rng()),
  twinkle: twinklePick(rng()),
  delay: rng() * 4
}));
---

<div class="star-field star-field-dark" id="star-field" aria-hidden="true">
  {stars.map((star) => (
    <div
      class={`star star-${star.size} star-twinkle-${star.twinkle}`}
      style={`left: ${star.x}%; top: ${star.y}%; animation-delay: ${star.delay}s;`}
    />
  ))}
</div>

<style>
  .star-field {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    transition: background 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .star-field :global(.star) {
      animation: none;
    }
  }
</style>
