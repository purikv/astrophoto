---
/**
 * GalleryCard Component
 * Enhanced gallery card with cosmic animations and effects
 */

import LazyImage from './LazyImage.astro';
import type { GalleryItem } from '../../types/gallery';

interface Props {
  item: GalleryItem;
  base: string;
  index?: number;
}

const { item, base, index = 0 } = Astro.props;
const delay = Math.min(index * 30, 270); // Cap at 270ms
// Eager-load the first 6 cards so LCP doesn't wait for IntersectionObserver.
const eager = index < 6;
---

<a
  href={`${base}/object/${item.object.id}`}
  class="gallery-card stagger-item"
  style={`animation-delay: ${delay}ms;`}
  data-object-id={item.object.id}
  data-object-type={item.object?.type}
  data-object-constellation={item.object?.constellation}
  data-object-distance={item.object?.distance_ly}
  data-object-description={item.object?.description}
  data-session-date={item.session?.date_utc}
>
  {item.preview && (
    <div class="card-image-wrapper">
      <LazyImage
        src={`${base}/${item.preview}`}
        alt={item.object?.name || item.title || ''}
        className="card-image"
        eager={eager}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      />
      <div class="card-glow"></div>
    </div>
  )}

  <div class="card-content">
    <h2 class="card-title">{item.object?.name || item.title}</h2>

    <div class="card-meta">
      {item.object?.type && (
        <span class="meta-tag primary">{item.object.type}</span>
      )}
      {item.object?.constellation && (
        <span class="meta-tag">{item.object.constellation}</span>
      )}
      {item.object?.distance_ly && (
        <span class="meta-tag">
          {item.object.distance_ly.toLocaleString('uk-UA')} св.р.
        </span>
      )}
    </div>
  </div>
</a>

<style>
  .gallery-card {
    display: block;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition-base);
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .gallery-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
    box-shadow: 0 0 24px rgba(168, 85, 247, 0.18),
                0 12px 28px rgba(0, 0, 0, 0.45);
  }

  .gallery-card:active {
    transform: translateY(-2px);
  }

  /* Card Image */
  .card-image-wrapper {
    position: relative;
    aspect-ratio: 4/3;
    background: linear-gradient(
      135deg,
      var(--color-bg-tertiary) 0%,
      var(--color-bg-secondary) 100%
    );
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
  }

  .gallery-card :global(.card-image img) {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.3s ease,
                opacity 0.3s ease;
  }

  .gallery-card:hover :global(.card-image img) {
    transform: scale(1.05);
    filter: brightness(1.05) contrast(1.05);
  }

  /* Cosmic Glow Effect */
  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(168, 85, 247, 0) 0%,
      rgba(168, 85, 247, 0.15) 100%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .gallery-card:hover .card-glow {
    opacity: 1;
  }

  /* Card Content */
  .card-content {
    padding: 1.25rem;
  }

  @media (min-width: 768px) {
    .card-content {
      padding: 1.5rem;
    }
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: var(--font-weight-regular);
    margin: 0 0 0.75rem 0;
    color: var(--color-text-primary);
    letter-spacing: var(--letter-spacing-normal);
    transition: color var(--transition-fast);
  }

  .gallery-card:hover .card-title {
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .card-title {
      font-size: 1.3rem;
    }
  }

  /* Meta Tags */
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-tag {
    background: transparent;
    padding: 0.25rem 0.65rem;
    font-size: 0.7rem;
    color: var(--color-text-tertiary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-wide);
    transition: all var(--transition-fast);
  }

  .meta-tag.primary {
    color: var(--color-text-secondary);
    border-color: var(--color-border-hover);
  }

  .gallery-card:hover .meta-tag {
    border-color: var(--color-border-hover);
  }

  .gallery-card:hover .meta-tag.primary {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    box-shadow: var(--glow-sm);
  }

  /* Focus State for Accessibility */
  .gallery-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  /* Stagger Animation */
  .stagger-item {
    opacity: 0;
    animation: slideInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .gallery-card {
      transition: none;
    }

    .gallery-card:hover {
      transform: none;
    }

    .stagger-item {
      animation: none;
      opacity: 1;
    }

    .gallery-card :global(.card-image img) {
      transition: none;
    }
  }
</style>
