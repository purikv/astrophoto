---
/**
 * LazyImage Component
 * Uses <picture> with AVIF/WebP/JPEG + responsive srcset.
 * Lazy-loads via a single shared IntersectionObserver (see <script>).
 *
 * Input `src` is expected to point at a JPEG thumbnail generated by
 * tools/make-thumbs.mjs, e.g. `thumbnails/m31_800.jpg`. Companion
 * formats/widths are derived from that filename.
 */

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  className?: string;
  eager?: boolean;
  /** Sizes attribute — override per usage context. */
  sizes?: string;
}

const {
  src,
  alt,
  width,
  height,
  className = '',
  eager = false,
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw'
} = Astro.props;

// Parse "…/name_800.jpg" → { dir, name, defaultWidth }
const match = src.match(/^(.*\/)?([^/]+)_(\d+)\.(\w+)$/);
const responsiveWidths = [400, 800, 1600];
const hasResponsive = !!match && responsiveWidths.includes(Number(match[3]));
const dir = match ? (match[1] || '') : '';
const name = match ? match[2] : '';

const buildSrcset = (ext: string) =>
  responsiveWidths.map(w => `${dir}${name}_${w}.${ext} ${w}w`).join(', ');

const fallback = hasResponsive ? `${dir}${name}_800.jpg` : src;
---

<picture class={`lazy-image-wrapper ${className}`}>
  {hasResponsive && (
    <>
      <source type="image/avif" data-srcset={buildSrcset('avif')} sizes={sizes} />
      <source type="image/webp" data-srcset={buildSrcset('webp')} sizes={sizes} />
    </>
  )}
  <img
    data-src={fallback}
    data-srcset={hasResponsive ? buildSrcset('jpg') : undefined}
    sizes={hasResponsive ? sizes : undefined}
    alt={alt}
    width={width}
    height={height}
    class="lazy-image"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  <span class="lazy-image-skeleton" aria-hidden="true"></span>
</picture>

<script>
  // Single shared IntersectionObserver for lazy loading.
  // Observes all current and future .lazy-image elements.
  // Promotes data-src/data-srcset → src/srcset on <img> and sibling <source> when entering viewport.
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const img = entry.target as HTMLImageElement;
      const picture = img.parentElement;

      // Swap <source> data-srcset → srcset
      picture?.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach(source => {
        if (source.dataset.srcset) source.srcset = source.dataset.srcset;
      });

      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      if (img.dataset.src && !img.src) img.src = img.dataset.src;

      img.addEventListener('load', () => {
        img.classList.add('loaded');
        picture?.querySelector('.lazy-image-skeleton')?.classList.add('hidden');
      }, { once: true });

      img.addEventListener('error', () => {
        img.classList.add('error');
        picture?.querySelector('.lazy-image-skeleton')?.classList.add('hidden');
      }, { once: true });

      obs.unobserve(img);
    });
  }, { root: null, rootMargin: '50px', threshold: 0.01 });

  const observed = new WeakSet<Element>();
  function observeAll() {
    document.querySelectorAll<HTMLImageElement>('.lazy-image').forEach(img => {
      if (img.src || observed.has(img)) return;
      // Eager images: swap immediately so browser preloads them.
      if (img.loading === 'eager') {
        const picture = img.parentElement;
        picture?.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach(s => {
          if (s.dataset.srcset) s.srcset = s.dataset.srcset;
        });
        if (img.dataset.srcset) img.srcset = img.dataset.srcset;
        if (img.dataset.src) img.src = img.dataset.src;
        observed.add(img);
        return;
      }
      observer.observe(img);
      observed.add(img);
    });
  }

  observeAll();
  window.addEventListener('gallery:changed', observeAll);
</script>

<style>
  .lazy-image-wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lazy-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }

  .lazy-image.loaded {
    opacity: 1;
  }

  .lazy-image.error {
    opacity: 0.3;
  }

  .lazy-image-skeleton {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--color-bg-secondary) 0%,
      var(--color-bg-tertiary) 50%,
      var(--color-bg-secondary) 100%
    );
    background-size: 200% 100%;
    animation: skeleton 1.5s ease-in-out infinite;
    transition: opacity 0.3s ease-out;
    pointer-events: none;
  }

  .lazy-image-skeleton.hidden {
    opacity: 0;
  }

  .lazy-image-skeleton::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.1) 50%,
      transparent 100%
    );
    animation: shimmer 2s linear infinite;
  }

  @keyframes skeleton {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @keyframes shimmer {
    0% { left: -100%; }
    100% { left: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lazy-image { transition: none; }
    .lazy-image-skeleton,
    .lazy-image-skeleton::before { animation: none; }
  }
</style>
