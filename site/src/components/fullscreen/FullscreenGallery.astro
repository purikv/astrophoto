---
/**
 * FullscreenGallery Component
 * Modal fullscreen viewer with navigation, zoom, and gestures
 */

interface Props {
  items: any[];
  currentIndex: number;
  base: string;
}

const { items, currentIndex, base } = Astro.props;
---

<div id="fullscreen-gallery" class="fullscreen-gallery" role="dialog" aria-modal="true" aria-label="Fullscreen gallery">
  <button class="fullscreen-close" aria-label="Close fullscreen" title="Закрити (Esc)">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <button class="fullscreen-nav fullscreen-prev" aria-label="Previous image" title="Попереднє (←, A)">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <button class="fullscreen-nav fullscreen-next" aria-label="Next image" title="Наступне (→, D)">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>

  <div class="fullscreen-content">
    <div class="fullscreen-image-container">
      <img
        id="fullscreen-image"
        class="fullscreen-image"
        src=""
        alt=""
        draggable="false"
      />
    </div>

    <div class="fullscreen-info">
      <h2 class="fullscreen-title"></h2>
      <div class="fullscreen-meta">
        <span class="meta-item type"></span>
        <span class="meta-item constellation"></span>
        <span class="meta-item distance"></span>
      </div>
    </div>
  </div>

  <div class="fullscreen-controls">
    <button class="control-btn zoom-out" aria-label="Zoom out" title="Зменшити (-)">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="8" y1="11" x2="14" y2="11"></line>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
    <button class="control-btn zoom-reset" aria-label="Reset zoom" title="Скинути">
      1:1
    </button>
    <button class="control-btn zoom-in" aria-label="Zoom in" title="Збільшити (+)">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="11" y1="8" x2="11" y2="14"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
  </div>

  <div class="fullscreen-counter">
    <span class="counter-current">1</span>
    <span class="counter-separator">/</span>
    <span class="counter-total">{items.length}</span>
  </div>
</div>

<style>
  .fullscreen-gallery {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.98);
    z-index: 9999;
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .fullscreen-gallery.active {
    display: flex;
    flex-direction: column;
    opacity: 1;
  }

  /* Close Button */
  .fullscreen-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    color: white;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
  }

  .fullscreen-close:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: var(--color-primary);
    box-shadow: var(--glow-md);
    transform: rotate(90deg);
  }

  /* Navigation Arrows */
  .fullscreen-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 64px;
    height: 64px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    color: white;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
  }

  .fullscreen-prev {
    left: 2rem;
  }

  .fullscreen-next {
    right: 2rem;
  }

  .fullscreen-nav:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: var(--color-primary);
    box-shadow: var(--glow-md);
    transform: translateY(-50%) scale(1.1);
  }

  .fullscreen-nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .fullscreen-nav:disabled:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: none;
    transform: translateY(-50%);
  }

  /* Content Area */
  .fullscreen-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6rem 2rem 2rem;
    overflow: hidden;
  }

  .fullscreen-image-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1920px;
    overflow: hidden;
    position: relative;
    cursor: grab;
  }

  .fullscreen-image-container.dragging {
    cursor: grabbing;
  }

  .fullscreen-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    -webkit-user-drag: none;
  }

  .fullscreen-image.zoomed {
    cursor: move;
  }

  /* Info Section */
  .fullscreen-info {
    padding: 1.5rem 0 0;
    text-align: center;
    color: white;
  }

  .fullscreen-title {
    font-size: 1.5rem;
    font-weight: var(--font-weight-regular);
    margin: 0 0 0.75rem 0;
    letter-spacing: var(--letter-spacing-normal);
  }

  .fullscreen-meta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .meta-item {
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    letter-spacing: var(--letter-spacing-wide);
  }

  .meta-item.type {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Controls */
  .fullscreen-controls {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    padding: 0.5rem;
  }

  .control-btn {
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
  }

  .control-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: var(--color-primary);
  }

  /* Counter */
  .fullscreen-counter {
    position: absolute;
    top: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    padding: 0.5rem 1.5rem;
    color: white;
    font-size: 0.9rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
  }

  .counter-separator {
    margin: 0 0.5rem;
    opacity: 0.5;
  }

  /* Mobile Adjustments */
  @media (max-width: 768px) {
    .fullscreen-nav {
      width: 48px;
      height: 48px;
    }

    .fullscreen-prev {
      left: 1rem;
    }

    .fullscreen-next {
      right: 1rem;
    }

    .fullscreen-close {
      top: 1rem;
      right: 1rem;
      width: 40px;
      height: 40px;
    }

    .fullscreen-counter {
      top: 1rem;
      font-size: 0.8rem;
      padding: 0.4rem 1rem;
    }

    .fullscreen-content {
      padding: 4rem 1rem 1rem;
    }

    .fullscreen-title {
      font-size: 1.2rem;
    }

    .fullscreen-controls {
      bottom: 1rem;
      scale: 0.9;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .fullscreen-gallery,
    .fullscreen-image,
    .fullscreen-nav,
    .fullscreen-close {
      transition: none;
    }
  }
</style>
