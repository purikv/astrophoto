---
import galleryData from '../data/gallery.json';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const siteUrl = 'https://purikv.github.io';
const pageUrl = `${siteUrl}${base}/showcase`;
const description = 'Слайдшоу астрофотографій у максимальній якості з можливістю наближення.';

const firstPreview = galleryData[0]?.preview;
const ogImage = firstPreview
  ? `${siteUrl}${base}/${firstPreview.split('/').map(encodeURIComponent).join('/')}`
  : `${siteUrl}${base}/thumbnails/default_800.jpg`;

const total = galleryData.length;
---

<BaseLayout
  title="Слайдшоу — Астрофотографія"
  description={description}
  canonicalUrl={pageUrl}
  ogImage={ogImage}
  bodyClass="showcase-body"
>
  <main id="showcase" class="showcase" aria-label="Слайдшоу астрофотографій">
    <a href={`${base}/`} class="showcase-close" aria-label="Повернутися до галереї" title="Закрити (Esc)">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </a>

    <div class="showcase-counter" aria-live="polite">
      <span class="counter-current">1</span>
      <span class="counter-separator">/</span>
      <span class="counter-total">{total}</span>
    </div>

    <button class="showcase-nav showcase-prev" aria-label="Попереднє фото" title="Попереднє (←)">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button class="showcase-nav showcase-next" aria-label="Наступне фото" title="Наступне (→)">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <div class="showcase-image-container">
      <div class="showcase-spinner" aria-hidden="true"></div>
      <img
        id="showcase-image"
        class="showcase-image"
        src=""
        alt=""
        draggable="false"
      />
    </div>

    <div class="showcase-zoom-controls" role="group" aria-label="Керування масштабом">
      <button class="zoom-btn zoom-out" aria-label="Зменшити" title="Зменшити (-)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
      <button class="zoom-btn zoom-reset" aria-label="Скинути масштаб" title="Скинути (0)">1:1</button>
      <button class="zoom-btn zoom-in" aria-label="Збільшити" title="Збільшити (+)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
    </div>

    <section class="showcase-info" aria-label="Опис об'єкта">
      <div class="showcase-info-header">
        <h1 class="showcase-title"></h1>
        <button class="showcase-info-btn" aria-label="Показати повний опис" aria-expanded="false" title="Показати/сховати опис (i)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        </button>
      </div>

      <div class="showcase-meta">
        <span class="meta-pill meta-type"></span>
        <span class="meta-pill meta-constellation"></span>
        <span class="meta-pill meta-distance"></span>
      </div>

      <p class="showcase-short-desc"></p>
      <div class="showcase-long-desc" aria-live="polite"></div>
    </section>
  </main>

  <script src="../scripts/showcase-gallery.ts"></script>
</BaseLayout>

<style is:global>
  body.showcase-body {
    margin: 0;
    padding: 0;
    background: #000;
    color: #e0e0e0;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }
</style>

<style>
  .showcase {
    position: fixed;
    inset: 0;
    background: #000;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
  }

  .showcase-image-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: default;
    touch-action: none;
  }

  .showcase-image-container.zoomed {
    cursor: grab;
  }

  .showcase-image-container.dragging {
    cursor: grabbing;
  }

  .showcase-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    transform-origin: center center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    opacity: 0;
  }

  .showcase-image.loaded {
    opacity: 1;
  }

  .showcase-spinner {
    position: absolute;
    width: 56px;
    height: 56px;
    border: 3px solid rgba(255, 255, 255, 0.08);
    border-top-color: rgba(168, 85, 247, 0.85);
    border-radius: 50%;
    animation: showcase-spin 0.8s linear infinite;
    z-index: 1;
    pointer-events: none;
  }

  .showcase-spinner.hidden {
    display: none;
  }

  @keyframes showcase-spin {
    to { transform: rotate(360deg); }
  }

  /* Close button */
  .showcase-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .showcase-close:hover,
  .showcase-close:focus-visible {
    background: rgba(239, 68, 68, 0.18);
    border-color: rgba(239, 68, 68, 0.5);
    color: #fff;
    transform: rotate(90deg);
    outline: none;
  }

  /* Counter */
  .showcase-counter {
    position: absolute;
    top: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 100px;
    padding: 0.45rem 1.1rem;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    z-index: 20;
    transition: opacity 0.3s ease;
  }

  .counter-separator {
    margin: 0 0.5rem;
    opacity: 0.4;
  }

  /* Nav arrows */
  .showcase-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .showcase-prev { left: 1.5rem; }
  .showcase-next { right: 1.5rem; }

  .showcase-nav:hover:not(:disabled),
  .showcase-nav:focus-visible:not(:disabled) {
    background: rgba(168, 85, 247, 0.2);
    border-color: rgba(168, 85, 247, 0.5);
    color: #fff;
    outline: none;
  }

  .showcase-nav:hover:not(:disabled).showcase-prev { transform: translateY(-50%) translateX(-3px); }
  .showcase-nav:hover:not(:disabled).showcase-next { transform: translateY(-50%) translateX(3px); }

  .showcase-nav:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  /* Zoom controls */
  .showcase-zoom-controls {
    position: absolute;
    bottom: calc(var(--info-height, 180px) + 1rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 0.4rem;
    z-index: 20;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .zoom-btn {
    width: 38px;
    height: 38px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .zoom-btn:hover,
  .zoom-btn:focus-visible {
    background: rgba(168, 85, 247, 0.2);
    color: #fff;
    outline: none;
  }

  /* Info panel (bottom) */
  .showcase-info {
    position: relative;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.85) 30%, rgba(0, 0, 0, 0.95) 100%);
    padding: 2.5rem 1.5rem 1.5rem;
    z-index: 10;
    pointer-events: auto;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .showcase-info-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1100px;
    margin: 0 auto 0.6rem;
  }

  .showcase-title {
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.01em;
    color: #fff;
    margin: 0;
    line-height: 1.2;
  }

  .showcase-info-btn {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .showcase-info-btn:hover,
  .showcase-info-btn:focus-visible {
    background: rgba(168, 85, 247, 0.2);
    border-color: rgba(168, 85, 247, 0.5);
    color: #fff;
    outline: none;
  }

  .showcase-info-btn.active {
    background: rgba(168, 85, 247, 0.3);
    border-color: rgba(168, 85, 247, 0.7);
    color: #fff;
  }

  .showcase-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 1100px;
    margin: 0 auto 0.75rem;
  }

  .meta-pill {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .meta-pill.meta-type {
    color: #c4a8ff;
    background: rgba(168, 85, 247, 0.12);
    border-color: rgba(168, 85, 247, 0.3);
  }

  .showcase-short-desc {
    max-width: 1100px;
    margin: 0 auto;
    font-size: 0.9rem;
    color: rgba(224, 224, 224, 0.85);
    line-height: 1.6;
    font-weight: 300;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .showcase-short-desc:empty {
    display: none;
  }

  .showcase-long-desc {
    max-width: 1100px;
    margin: 1rem auto 0;
    font-size: 0.9rem;
    color: rgba(224, 224, 224, 0.9);
    line-height: 1.7;
    font-weight: 300;
    white-space: pre-line;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), margin-top 0.3s ease;
  }

  .showcase-long-desc.open {
    max-height: 50vh;
    overflow-y: auto;
  }

  .showcase-long-desc.open + * {
    margin-top: 1rem;
  }

  /* Auto-hide controls */
  .showcase.controls-hidden .showcase-close,
  .showcase.controls-hidden .showcase-counter,
  .showcase.controls-hidden .showcase-nav,
  .showcase.controls-hidden .showcase-zoom-controls {
    opacity: 0;
    pointer-events: none;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .showcase-prev { left: 0.5rem; }
    .showcase-next { right: 0.5rem; }
    .showcase-nav {
      width: 44px;
      height: 44px;
    }
    .showcase-close {
      top: 0.75rem;
      right: 0.75rem;
      width: 40px;
      height: 40px;
    }
    .showcase-counter {
      top: 0.75rem;
      font-size: 0.75rem;
      padding: 0.35rem 0.85rem;
    }
    .showcase-info {
      padding: 2rem 1rem 1rem;
    }
    .showcase-title {
      font-size: 1.15rem;
    }
    .showcase-short-desc {
      font-size: 0.82rem;
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
    .showcase-zoom-controls {
      bottom: calc(var(--info-height, 160px) + 0.6rem);
      transform: translateX(-50%) scale(0.92);
    }
    .meta-pill {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 480px) {
    .showcase-info-header {
      gap: 0.5rem;
    }
    .showcase-info-btn {
      width: 34px;
      height: 34px;
    }
  }

  /* Landscape mobile: image-first, floating chrome, max viewport real-estate */
  @media (orientation: landscape) and (max-height: 500px) {
    .showcase {
      grid-template-rows: 1fr;
    }

    .showcase-image-container {
      padding: 0;
    }

    /* Compact close — top-right with safe-area */
    .showcase-close {
      top: calc(env(safe-area-inset-top, 0px) + 0.4rem);
      right: calc(env(safe-area-inset-right, 0px) + 0.4rem);
      width: 36px;
      height: 36px;
    }

    /* Counter moves to top-left to balance close, doesn't fight info panel */
    .showcase-counter {
      top: calc(env(safe-area-inset-top, 0px) + 0.5rem);
      left: calc(env(safe-area-inset-left, 0px) + 0.5rem);
      transform: none;
      font-size: 0.7rem;
      padding: 0.25rem 0.65rem;
    }

    /* Smaller nav arrows hugging the edges */
    .showcase-nav {
      width: 38px;
      height: 38px;
    }
    .showcase-prev {
      left: calc(env(safe-area-inset-left, 0px) + 0.3rem);
    }
    .showcase-next {
      right: calc(env(safe-area-inset-right, 0px) + 0.3rem);
    }
    .showcase-nav:hover:not(:disabled).showcase-prev { transform: translateY(-50%) translateX(-2px); }
    .showcase-nav:hover:not(:disabled).showcase-next { transform: translateY(-50%) translateX(2px); }

    /* Info panel becomes a floating glass chip at bottom-left */
    .showcase-info {
      position: absolute;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 0.4rem);
      left: calc(env(safe-area-inset-left, 0px) + 0.4rem);
      max-width: min(58vw, 460px);
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 0.5rem 0.75rem;
      z-index: 15;
    }

    .showcase-info-header {
      margin: 0 0 0.3rem;
      gap: 0.5rem;
    }

    .showcase-title {
      font-size: 0.95rem;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .showcase-info-btn {
      width: 28px;
      height: 28px;
    }

    .showcase-info-btn svg {
      width: 14px;
      height: 14px;
    }

    .showcase-meta {
      margin: 0;
      gap: 0.3rem;
    }

    .meta-pill {
      font-size: 0.62rem;
      padding: 0.12rem 0.5rem;
    }

    /* Hide the always-visible 2-line preview; full description appears via "i" */
    .showcase-short-desc {
      display: none;
    }

    .showcase-long-desc {
      font-size: 0.78rem;
      line-height: 1.5;
    }

    .showcase-long-desc.open {
      max-height: 38vh;
      margin-top: 0.5rem;
      padding-right: 0.25rem;
    }

    /* Zoom controls — bottom-right corner, away from info chip */
    .showcase-zoom-controls {
      bottom: calc(env(safe-area-inset-bottom, 0px) + 0.4rem);
      right: calc(env(safe-area-inset-right, 0px) + 0.4rem);
      left: auto;
      transform: none;
      padding: 0.25rem;
      gap: 0.2rem;
      border-radius: 10px;
    }

    .zoom-btn {
      width: 32px;
      height: 32px;
      font-size: 0.65rem;
    }

    .zoom-btn svg {
      width: 14px;
      height: 14px;
    }

    /* When controls are auto-hidden, gently fade info chip too */
    .showcase.controls-hidden .showcase-info {
      opacity: 0.35;
      transition: opacity 0.3s ease;
    }
  }

  /* Very short landscape (older phones, ~320–375 height): info chip more compact */
  @media (orientation: landscape) and (max-height: 380px) {
    .showcase-info {
      padding: 0.4rem 0.6rem;
      max-width: 52vw;
    }
    .showcase-info-header {
      margin: 0 0 0.25rem;
    }
    .showcase-title {
      font-size: 0.85rem;
    }
    .meta-pill {
      font-size: 0.6rem;
      padding: 0.1rem 0.42rem;
    }
    .showcase-long-desc.open {
      max-height: 50vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-image,
    .showcase-info,
    .showcase-close,
    .showcase-nav,
    .showcase-zoom-controls,
    .showcase-counter,
    .showcase-long-desc {
      transition: none;
    }
    .showcase-spinner {
      animation: none;
    }
  }
</style>
