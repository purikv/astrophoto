---
import galleryData from '../../data/gallery.json';

const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return galleryData.map((item) => ({
    params: { id: item.object.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const object = item.object;
const session = item.session;

// Find related items (same constellation or same type, exclude current)
const relatedItems = galleryData
  .filter((i) =>
    i.object.id !== object.id &&
    (i.object.constellation === object.constellation || i.object.type === object.type)
  )
  .slice(0, 3); // Show max 3 related items

// Full URLs for Open Graph
const siteUrl = 'https://purikv.github.io';
const pageUrl = `${siteUrl}${base}/object/${object.id}`;
// Use 800px version for faster loading in messengers (50-200 KB vs 200-900 KB)
// URL-encode the image path to handle Cyrillic characters
const imageUrl = item.preview
  ? `${siteUrl}${base}/${item.preview.split('/').map(encodeURIComponent).join('/')}`
  : `${siteUrl}${base}/thumbnails/default_800.jpg`;
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="base-url" content={base} />
    <title>{object.name} - Astro Gallery</title>
    <meta name="description" content={object.description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={`${object.name} - Астрофотографія`} />
    <meta property="og:description" content={object.description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="533" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content="Astro Gallery - Володимир Пурик" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={`${object.name} - Астрофотографія`} />
    <meta name="twitter:description" content={object.description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Additional meta -->
    <meta name="author" content="Володимир Пурик" />
    <link rel="canonical" href={pageUrl} />
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        margin: 0;
        padding: 0;
        background: #000;
        color: #e0e0e0;
        line-height: 1.7;
      }

      /* Navigation */
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        z-index: 100;
        padding: 1.5rem 2rem;
      }

      .nav-content {
        max-width: 100%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .back-link {
        color: #666;
        text-decoration: none;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
        font-weight: 300;
        letter-spacing: 0.03em;
      }

      .back-link:hover {
        color: #fff;
        transform: translateX(-2px);
      }

      /* Hero Section - Removed, image now in main content */

      /* Content Layout */
      .content {
        display: flex;
        min-height: calc(100vh - 70px);
        margin-top: 70px;
      }

      @media (max-width: 1023px) {
        .content {
          flex-direction: column;
        }
      }

      /* Main Content - 2/3 width */
      .main-content {
        flex: 2;
        position: relative;
        background: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      @media (min-width: 1024px) {
        .main-content {
          position: sticky;
          top: 70px;
          height: calc(100vh - 70px);
          padding: 4rem;
        }
      }

      .image-container {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: zoom-in;
        transition: all 0.4s ease;
      }

      .main-image {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        transition: transform 0.4s ease, opacity 0.3s ease;
      }

      .image-container:hover .main-image {
        transform: scale(1.02);
        opacity: 0.9;
      }

      .zoom-hint {
        position: absolute;
        bottom: 2rem;
        right: 2rem;
        color: rgba(255, 255, 255, 0.3);
        font-size: 0.75rem;
        font-weight: 300;
        letter-spacing: 0.05em;
        pointer-events: none;
        transition: opacity 0.3s;
      }

      .image-container:hover .zoom-hint {
        opacity: 0;
      }

      /* Sidebar - 1/3 width */
      .sidebar {
        flex: 1;
        background: #000;
        padding: 3rem 2rem;
        overflow-y: auto;
        border-left: 1px solid rgba(255, 255, 255, 0.05);
      }

      @media (min-width: 1024px) {
        .sidebar {
          padding: 4rem 3rem;
          max-height: calc(100vh - 70px);
        }
      }

      .sidebar-title {
        font-size: 2rem;
        font-weight: 300;
        margin: 0 0 0.5rem 0;
        color: #fff;
        letter-spacing: -0.01em;
        line-height: 1.2;
      }

      .sidebar-subtitle {
        font-size: 0.9rem;
        color: #666;
        margin: 0 0 3rem 0;
        font-weight: 300;
        letter-spacing: 0.02em;
      }

      /* Section Styles */
      .section {
        margin-bottom: 2rem;
      }

      .section:last-child {
        margin-bottom: 0;
      }

      .section-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.7rem;
        font-weight: 500;
        margin: 0 0 1rem 0;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .section-title svg {
        opacity: 0.6;
      }

      .section-content {
        font-size: 0.95rem;
        color: #bbb;
        line-height: 1.7;
        font-weight: 300;
        margin-bottom: 2rem;
      }

      /* Data Table - Premium Compact Design */
      .data-table {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        overflow: hidden;
      }

      .data-table.compact {
        background: transparent;
        border: none;
      }

      .data-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
        min-height: 42px;
      }

      .data-table.compact .data-row {
        padding: 0.65rem 0;
      }

      .data-row:last-child {
        border-bottom: none;
      }

      .data-row:hover {
        background: rgba(168, 85, 247, 0.03);
      }

      .data-row.aliases-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
        padding-top: 0.85rem;
        padding-bottom: 0.85rem;
      }

      .data-cell {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .data-cell.label {
        font-size: 0.7rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 400;
        min-width: 110px;
        flex-shrink: 0;
      }

      .data-cell.label svg {
        opacity: 0.5;
        flex-shrink: 0;
      }

      .data-cell.value {
        font-size: 0.875rem;
        color: #ddd;
        font-weight: 300;
        text-align: right;
        flex: 1;
        line-height: 1.5;
      }

      /* Aliases Compact */
      .aliases-compact {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        width: 100%;
      }

      .alias-tag {
        background: rgba(168, 85, 247, 0.1);
        padding: 0.2rem 0.5rem;
        font-size: 0.7rem;
        color: #a855f7;
        border: 1px solid rgba(168, 85, 247, 0.2);
        border-radius: 4px;
        font-weight: 400;
        white-space: nowrap;
      }

      /* Bortle Indicator */
      .bortle-indicator {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
      }

      .bortle-value {
        font-weight: 500;
        color: #fff;
        min-width: 16px;
      }

      .bortle-bar {
        flex: 1;
        height: 6px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
        overflow: hidden;
      }

      .bortle-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 0.3s ease;
        box-shadow: 0 0 8px currentColor;
      }

      /* Exposure Table - Premium Design */
      .exposure-table {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        overflow: hidden;
      }

      .exposure-row {
        display: grid;
        grid-template-columns: 100px 1fr auto;
        gap: 1rem;
        align-items: center;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
      }

      .exposure-row:last-of-type {
        border-bottom: none;
      }

      .exposure-row:hover {
        background: rgba(168, 85, 247, 0.03);
      }

      .exposure-band {
        font-size: 0.75rem;
        font-weight: 500;
        color: #a855f7;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.25rem 0.5rem;
        background: rgba(168, 85, 247, 0.1);
        border: 1px solid rgba(168, 85, 247, 0.2);
        border-radius: 4px;
        text-align: center;
        width: fit-content;
      }

      .exposure-details {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .exposure-count {
        font-size: 0.875rem;
        color: #ddd;
        font-weight: 300;
      }

      .exposure-iso {
        font-size: 0.7rem;
        color: #888;
      }

      .exposure-time {
        font-size: 0.875rem;
        color: #fff;
        font-weight: 400;
        text-align: right;
        min-width: 60px;
      }

      .exposure-total {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem;
        background: rgba(168, 85, 247, 0.05);
        border-top: 1px solid rgba(168, 85, 247, 0.2);
      }

      .total-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.7rem;
        color: #a855f7;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 500;
      }

      .total-label svg {
        opacity: 0.8;
      }

      .total-value {
        font-size: 1rem;
        color: #fff;
        font-weight: 500;
      }

      /* Guiding RMS Badge */
      .guiding-rms {
        display: inline-block;
        margin-left: 0.5rem;
        padding: 0.15rem 0.4rem;
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 500;
      }

      /* Related Items */
      .related-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr;
      }

      .related-card {
        display: flex;
        gap: 1rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 0.75rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
        align-items: center;
      }

      .related-card:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.1);
        transform: translateX(4px);
      }

      .related-image {
        width: 80px;
        height: 60px;
        object-fit: contain;
        object-position: center;
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.02);
        padding: 0.25rem;
        border-radius: 4px;
      }

      .related-info {
        flex: 1;
        min-width: 0;
      }

      .related-title {
        font-size: 0.9rem;
        font-weight: 400;
        margin: 0 0 0.25rem 0;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .related-meta {
        font-size: 0.75rem;
        color: #888;
        margin: 0;
        font-weight: 300;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Responsive Adjustments */
      @media (max-width: 768px) {
        .data-cell.label {
          min-width: 90px;
          font-size: 0.65rem;
        }

        .data-cell.value {
          font-size: 0.8rem;
        }

        .exposure-row {
          grid-template-columns: 80px 1fr auto;
          gap: 0.75rem;
          padding: 0.65rem 0.75rem;
        }

        .exposure-band {
          font-size: 0.7rem;
          padding: 0.2rem 0.4rem;
        }

        .exposure-count {
          font-size: 0.8rem;
        }

        .exposure-time {
          font-size: 0.8rem;
          min-width: 50px;
        }

        .exposure-total {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
          padding: 0.75rem;
        }

        .total-value {
          font-size: 0.9rem;
          align-self: flex-end;
        }

        .sidebar-title {
          font-size: 1.5rem;
        }

        .sidebar-subtitle {
          font-size: 0.85rem;
        }
      }

      /* Smooth Animations */
      @media (prefers-reduced-motion: no-preference) {
        .data-row {
          animation: fadeInUp 0.3s ease-out backwards;
        }

        .data-row:nth-child(1) { animation-delay: 0.05s; }
        .data-row:nth-child(2) { animation-delay: 0.1s; }
        .data-row:nth-child(3) { animation-delay: 0.15s; }
        .data-row:nth-child(4) { animation-delay: 0.2s; }
        .data-row:nth-child(5) { animation-delay: 0.25s; }

        @keyframes fadeInUp {
          from {
            opacity: 0;
            transform: translateY(10px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <div class="nav-content">
        <a href={`${base}/`} class="back-link">
          <span>←</span>
          <span>Галерея</span>
        </a>
      </div>
    </nav>

    <div class="content">
      <div class="main-content">
        {item.preview && (
          <div class="image-container" id="image-container">
            <img
              src={`${base}/${item.preview.replace('_800', '_2000')}`}
              alt={object.name}
              class="main-image"
              id="main-image"
              data-full={`${base}/${item.preview.replace('_800', '_2000')}`}
            />
            <div class="zoom-hint">Клік для перегляду у повному розмірі</div>
          </div>
        )}
      </div>

      <aside class="sidebar">
        <h1 class="sidebar-title">{object.name}</h1>
        <p class="sidebar-subtitle">{object.type} · {object.constellation}</p>

        <div class="section">
          <div class="section-content">
            <p>{object.description}</p>
            {object.extended_description && (
              <p style="margin-top: 1rem; opacity: 0.8;">{object.extended_description}</p>
            )}
          </div>
        </div>

        <div class="section">
          <h2 class="section-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 16v-4M12 8h.01"/>
            </svg>
            Quick Facts
          </h2>
          <div class="data-table">
            {object.distance_ly && (
              <div class="data-row">
                <div class="data-cell label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  Distance
                </div>
                <div class="data-cell value">{object.distance_ly.toLocaleString('uk-UA')} св.р.</div>
              </div>
            )}
            {session?.date_utc && (
              <div class="data-row">
                <div class="data-cell label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  Captured
                </div>
                <div class="data-cell value">{session.date_utc}</div>
              </div>
            )}
            {session?.location && (
              <div class="data-row">
                <div class="data-cell label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="2" y1="12" x2="22" y2="12"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                  Location
                </div>
                <div class="data-cell value">{session.location}</div>
              </div>
            )}
            {session?.bortle && (
              <div class="data-row">
                <div class="data-cell label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                  </svg>
                  Bortle
                </div>
                <div class="data-cell value">
                  <div class="bortle-indicator">
                    <span class="bortle-value">{session.bortle}</span>
                    <div class="bortle-bar">
                      <div class="bortle-fill" style={`width: ${(session.bortle / 9) * 100}%; background: ${session.bortle <= 3 ? '#10b981' : session.bortle <= 6 ? '#f59e0b' : '#ef4444'}`}></div>
                    </div>
                  </div>
                </div>
              </div>
            )}
            {object.aliases && object.aliases.length > 0 && (
              <div class="data-row aliases-row">
                <div class="data-cell label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 7h16M4 12h16M4 17h10"/>
                  </svg>
                  Also known as
                </div>
                <div class="data-cell value">
                  <div class="aliases-compact">
                    {object.aliases.map((alias) => (
                      <span class="alias-tag">{alias}</span>
                    ))}
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>

        {session?.subs && session.subs.length > 0 && (
          <div class="section">
            <h2 class="section-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              Exposure
            </h2>
            <div class="exposure-table">
              {session.subs.map((sub) => (
                <div class="exposure-row">
                  <div class="exposure-band">{sub.band}</div>
                  <div class="exposure-details">
                    <span class="exposure-count">{sub.count} × {sub.exposure_s}s</span>
                    {sub.iso && <span class="exposure-iso">ISO {sub.iso}</span>}
                  </div>
                  <div class="exposure-time">{((sub.count * sub.exposure_s) / 3600).toFixed(2)}h</div>
                </div>
              ))}
              <div class="exposure-total">
                <div class="total-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  Total Integration
                </div>
                <div class="total-value">
                  {(session.subs.reduce((acc, sub) => acc + (sub.count * sub.exposure_s), 0) / 3600).toFixed(2)} години
                </div>
              </div>
            </div>
          </div>
        )}

        {(session?.camera || session?.telescope) && (
          <div class="section">
            <h2 class="section-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
              Equipment
            </h2>
            <div class="data-table compact">
              {session.camera && (
                <div class="data-row">
                  <div class="data-cell label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="4" width="20" height="16" rx="2"/>
                      <circle cx="12" cy="12" r="3"/>
                    </svg>
                    Camera
                  </div>
                  <div class="data-cell value">{session.camera}</div>
                </div>
              )}
              {session.telescope && (
                <div class="data-row">
                  <div class="data-cell label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="3"/>
                      <line x1="12" y1="1" x2="12" y2="9"/>
                      <line x1="12" y1="15" x2="12" y2="23"/>
                    </svg>
                    Telescope
                  </div>
                  <div class="data-cell value">{session.telescope}</div>
                </div>
              )}
              {session.mount && (
                <div class="data-row">
                  <div class="data-cell label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                    Mount
                  </div>
                  <div class="data-cell value">{session.mount}</div>
                </div>
              )}
              {session.coma_corrector && (
                <div class="data-row">
                  <div class="data-cell label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/>
                      <circle cx="12" cy="12" r="6"/>
                      <circle cx="12" cy="12" r="2"/>
                    </svg>
                    Corrector
                  </div>
                  <div class="data-cell value">{session.coma_corrector}</div>
                </div>
              )}
              {session.filters && session.filters.length > 0 && (
                <div class="data-row">
                  <div class="data-cell label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                    Filters
                  </div>
                  <div class="data-cell value">{session.filters.join(', ')}</div>
                </div>
              )}
              {session.guiding && (
                <div class="data-row">
                  <div class="data-cell label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                    </svg>
                    Guiding
                  </div>
                  <div class="data-cell value">
                    {session.guiding.software}
                    {session.guiding.rms_arcsec && session.guiding.rms_arcsec !== null && (
                      <span class="guiding-rms">RMS {session.guiding.rms_arcsec}"</span>
                    )}
                  </div>
                </div>
              )}
            </div>
          </div>
        )}

        {(session?.stacking_software || session?.processing_software) && (
          <div class="section">
            <h2 class="section-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
              Processing
            </h2>
            <div class="data-table compact">
              {session.stacking_software && (
                <div class="data-row">
                  <div class="data-cell label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <line x1="9" y1="9" x2="15" y2="15"/>
                      <line x1="15" y1="9" x2="9" y2="15"/>
                    </svg>
                    Stacking
                  </div>
                  <div class="data-cell value">{session.stacking_software}</div>
                </div>
              )}
              {session.processing_software && session.processing_software.length > 0 && (
                <div class="data-row">
                  <div class="data-cell label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20 7h-9M14 17H5M17 3v18M10 7l-3 10"/>
                    </svg>
                    Processing
                  </div>
                  <div class="data-cell value">{session.processing_software.join(', ')}</div>
                </div>
              )}
            </div>
          </div>
        )}

        {(object.credits || object.license) && (
          <div class="section">
            <h2 class="section-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
              </svg>
              Copyright
            </h2>
            <div class="data-table compact">
              {object.credits && (
                <div class="data-row">
                  <div class="data-cell label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                      <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Author
                  </div>
                  <div class="data-cell value">{object.credits}</div>
                </div>
              )}
              {object.license && (
                <div class="data-row">
                  <div class="data-cell label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                      <line x1="12" y1="18" x2="12.01" y2="18"/>
                      <path d="M12 6v6"/>
                    </svg>
                    License
                  </div>
                  <div class="data-cell value">{object.license}</div>
                </div>
              )}
            </div>
          </div>
        )}

        {relatedItems.length > 0 && (
          <div class="section">
            <h2 class="section-title">Схожі об'єкти</h2>
            <div class="related-grid">
              {relatedItems.map((relatedItem) => (
                <a href={`${base}/object/${relatedItem.object.id}`} class="related-card">
                  {relatedItem.preview && (
                    <img
                      src={`${base}/${relatedItem.preview}`}
                      alt={relatedItem.object.name}
                      class="related-image"
                    />
                  )}
                  <div class="related-info">
                    <h3 class="related-title">{relatedItem.object.name}</h3>
                    <p class="related-meta">
                      {relatedItem.object.type}{relatedItem.object.constellation && ` · ${relatedItem.object.constellation}`}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    <script src="../../scripts/init-fullscreen.ts"></script>
  </body>
</html>
