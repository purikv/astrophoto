---
import galleryData from '../../data/gallery.json';
import FullscreenGallery from '../../components/fullscreen/FullscreenGallery.astro';

const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return galleryData.map((item) => ({
    params: { id: item.object.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const object = item.object;
const session = item.session;

// Find current index in gallery for fullscreen navigation
const currentIndex = galleryData.findIndex((i) => i.object.id === object.id);

// Find related items (same constellation or same type, exclude current)
const relatedItems = galleryData
  .filter((i) =>
    i.object.id !== object.id &&
    (i.object.constellation === object.constellation || i.object.type === object.type)
  )
  .slice(0, 3); // Show max 3 related items

// Full URLs for Open Graph
const siteUrl = 'https://purikv.github.io';
const pageUrl = `${siteUrl}${base}/object/${object.id}`;
// Use 800px version for faster loading in messengers (50-200 KB vs 200-900 KB)
// URL-encode the image path to handle Cyrillic characters
const imageUrl = item.preview
  ? `${siteUrl}${base}/${item.preview.split('/').map(encodeURIComponent).join('/')}`
  : `${siteUrl}${base}/thumbnails/default_800.jpg`;
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="base-url" content={base} />
    <title>{object.name} - Astro Gallery</title>
    <meta name="description" content={object.description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={`${object.name} - Астрофотографія`} />
    <meta property="og:description" content={object.description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="533" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content="Astro Gallery - Володимир Пурик" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={`${object.name} - Астрофотографія`} />
    <meta name="twitter:description" content={object.description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Additional meta -->
    <meta name="author" content="Володимир Пурик" />
    <link rel="canonical" href={pageUrl} />
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        margin: 0;
        padding: 0;
        background: #000;
        color: #e0e0e0;
        line-height: 1.7;
      }

      /* Navigation */
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        z-index: 100;
        padding: 1.5rem 2rem;
      }

      .nav-content {
        max-width: 100%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .back-link {
        color: #666;
        text-decoration: none;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
        font-weight: 300;
        letter-spacing: 0.03em;
      }

      .back-link:hover {
        color: #fff;
        transform: translateX(-2px);
      }

      /* Hero Section - Removed, image now in main content */

      /* Content Layout */
      .content {
        display: flex;
        min-height: calc(100vh - 70px);
        margin-top: 70px;
      }

      @media (max-width: 1023px) {
        .content {
          flex-direction: column;
        }
      }

      /* Main Content - 2/3 width */
      .main-content {
        flex: 2;
        position: relative;
        background: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      @media (min-width: 1024px) {
        .main-content {
          position: sticky;
          top: 70px;
          height: calc(100vh - 70px);
          padding: 4rem;
        }
      }

      .image-container {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: zoom-in;
        transition: all 0.4s ease;
      }

      .main-image {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        transition: transform 0.4s ease, opacity 0.3s ease;
      }

      .image-container:hover .main-image {
        transform: scale(1.02);
        opacity: 0.9;
      }

      .zoom-hint {
        position: absolute;
        bottom: 2rem;
        right: 2rem;
        color: rgba(255, 255, 255, 0.3);
        font-size: 0.75rem;
        font-weight: 300;
        letter-spacing: 0.05em;
        pointer-events: none;
        transition: opacity 0.3s;
      }

      .image-container:hover .zoom-hint {
        opacity: 0;
      }

      /* Sidebar - 1/3 width */
      .sidebar {
        flex: 1;
        background: #000;
        padding: 3rem 2rem;
        overflow-y: auto;
        border-left: 1px solid rgba(255, 255, 255, 0.05);
      }

      @media (min-width: 1024px) {
        .sidebar {
          padding: 4rem 3rem;
          max-height: calc(100vh - 70px);
        }
      }

      .sidebar-title {
        font-size: 2rem;
        font-weight: 300;
        margin: 0 0 0.5rem 0;
        color: #fff;
        letter-spacing: -0.01em;
        line-height: 1.2;
      }

      .sidebar-subtitle {
        font-size: 0.9rem;
        color: #666;
        margin: 0 0 3rem 0;
        font-weight: 300;
        letter-spacing: 0.02em;
      }

      /* Section Styles */
      .section {
        margin-bottom: 3rem;
        padding-bottom: 3rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      }

      .section:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      .section-title {
        font-size: 0.7rem;
        font-weight: 400;
        margin: 0 0 1.5rem 0;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .section-content {
        font-size: 0.95rem;
        color: #bbb;
        line-height: 1.8;
        font-weight: 300;
      }

      /* Info Grid */
      .info-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-bottom: 2rem;
      }

      .info-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .info-label {
        font-size: 0.65rem;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 400;
      }

      .info-value {
        font-size: 0.95rem;
        color: #ddd;
        font-weight: 300;
        line-height: 1.6;
      }

      /* Aliases */
      .aliases {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .alias-badge {
        background: transparent;
        padding: 0.25rem 0.6rem;
        font-size: 0.75rem;
        color: #888;
        border: 1px solid rgba(255, 255, 255, 0.1);
        font-weight: 300;
      }

      /* Related Items */
      .related-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr;
      }

      .related-card {
        display: flex;
        gap: 1rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 0.75rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
        align-items: center;
      }

      .related-card:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.1);
        transform: translateX(4px);
      }

      .related-image {
        width: 80px;
        height: 60px;
        object-fit: cover;
        flex-shrink: 0;
      }

      .related-info {
        flex: 1;
        min-width: 0;
      }

      .related-title {
        font-size: 0.9rem;
        font-weight: 400;
        margin: 0 0 0.25rem 0;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .related-meta {
        font-size: 0.75rem;
        color: #888;
        margin: 0;
        font-weight: 300;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <div class="nav-content">
        <a href={`${base}/`} class="back-link">
          <span>←</span>
          <span>Галерея</span>
        </a>
      </div>
    </nav>

    <div class="content">
      <div class="main-content">
        {item.preview && (
          <div class="image-container" id="image-container">
            <img
              src={`${base}/${item.preview.replace('_800', '_2000')}`}
              alt={object.name}
              class="main-image"
              id="main-image"
              data-full={`${base}/${item.preview.replace('_800', '_2000')}`}
            />
            <div class="zoom-hint">Клік для fullscreen галереї</div>
          </div>
        )}
      </div>

      <aside class="sidebar">
        <h1 class="sidebar-title">{object.name}</h1>
        <p class="sidebar-subtitle">{object.type} · {object.constellation}</p>

        <div class="section">
          <h2 class="section-title">About</h2>
          <div class="section-content">
            <p>{object.description}</p>
            {object.extended_description && (
              <p style="margin-top: 1.5rem;">{object.extended_description}</p>
            )}
          </div>
        </div>

        <div class="section">
          <h2 class="section-title">Quick Facts</h2>
          <div class="info-grid">
            {object.distance_ly && (
              <div class="info-item">
                <span class="info-label">Distance</span>
                <span class="info-value">{object.distance_ly.toLocaleString('uk-UA')} light-years</span>
              </div>
            )}
            {session?.date_utc && (
              <div class="info-item">
                <span class="info-label">Captured</span>
                <span class="info-value">{session.date_utc}</span>
              </div>
            )}
            {session?.location && (
              <div class="info-item">
                <span class="info-label">Location</span>
                <span class="info-value">{session.location}{session.bortle && ` · Bortle ${session.bortle}`}</span>
              </div>
            )}
            {object.aliases && object.aliases.length > 0 && (
              <div class="info-item">
                <span class="info-label">Also known as</span>
                <div class="aliases">
                  {object.aliases.map((alias) => (
                    <span class="alias-badge">{alias}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        {session?.subs && session.subs.length > 0 && (
          <div class="section">
            <h2 class="section-title">Exposure</h2>
            <div class="info-grid">
              {session.subs.map((sub) => (
                <div class="info-item">
                  <span class="info-label">{sub.band}</span>
                  <span class="info-value">
                    {sub.count} × {sub.exposure_s}s
                    {sub.iso && ` · ISO ${sub.iso}`}
                  </span>
                </div>
              ))}
              <div class="info-item">
                <span class="info-label">Total integration</span>
                <span class="info-value">
                  {(session.subs.reduce((acc, sub) => acc + (sub.count * sub.exposure_s), 0) / 3600).toFixed(1)} hours
                </span>
              </div>
            </div>
          </div>
        )}

        {(session?.camera || session?.telescope) && (
          <div class="section">
            <h2 class="section-title">Equipment</h2>
            <div class="info-grid">
              {session.camera && (
                <div class="info-item">
                  <span class="info-label">Camera</span>
                  <span class="info-value">{session.camera}</span>
                </div>
              )}
              {session.telescope && (
                <div class="info-item">
                  <span class="info-label">Telescope</span>
                  <span class="info-value">{session.telescope}</span>
                </div>
              )}
              {session.mount && (
                <div class="info-item">
                  <span class="info-label">Mount</span>
                  <span class="info-value">{session.mount}</span>
                </div>
              )}
              {session.coma_corrector && (
                <div class="info-item">
                  <span class="info-label">Corrector</span>
                  <span class="info-value">{session.coma_corrector}</span>
                </div>
              )}
              {session.filters && session.filters.length > 0 && (
                <div class="info-item">
                  <span class="info-label">Filters</span>
                  <span class="info-value">{session.filters.join(', ')}</span>
                </div>
              )}
              {session.guiding && (
                <div class="info-item">
                  <span class="info-label">Guiding</span>
                  <span class="info-value">
                    {session.guiding.software}
                    {session.guiding.rms_arcsec && session.guiding.rms_arcsec !== null && ` · RMS ${session.guiding.rms_arcsec}"`}
                  </span>
                </div>
              )}
            </div>
          </div>
        )}

        {(session?.stacking_software || session?.processing_software) && (
          <div class="section">
            <h2 class="section-title">Processing</h2>
            <div class="info-grid">
              {session.stacking_software && (
                <div class="info-item">
                  <span class="info-label">Stacking</span>
                  <span class="info-value">{session.stacking_software}</span>
                </div>
              )}
              {session.processing_software && session.processing_software.length > 0 && (
                <div class="info-item">
                  <span class="info-label">Processing</span>
                  <span class="info-value">{session.processing_software.join(', ')}</span>
                </div>
              )}
            </div>
          </div>
        )}

        {(object.credits || object.license) && (
          <div class="section">
            <h2 class="section-title">Copyright</h2>
            <div class="info-grid">
              {object.credits && (
                <div class="info-item">
                  <span class="info-label">Author</span>
                  <span class="info-value">{object.credits}</span>
                </div>
              )}
              {object.license && (
                <div class="info-item">
                  <span class="info-label">License</span>
                  <span class="info-value">{object.license}</span>
                </div>
              )}
            </div>
          </div>
        )}

        {relatedItems.length > 0 && (
          <div class="section">
            <h2 class="section-title">Схожі об'єкти</h2>
            <div class="related-grid">
              {relatedItems.map((relatedItem) => (
                <a href={`${base}/object/${relatedItem.object.id}`} class="related-card">
                  {relatedItem.preview && (
                    <img
                      src={`${base}/${relatedItem.preview}`}
                      alt={relatedItem.object.name}
                      class="related-image"
                    />
                  )}
                  <div class="related-info">
                    <h3 class="related-title">{relatedItem.object.name}</h3>
                    <p class="related-meta">
                      {relatedItem.object.type}{relatedItem.object.constellation && ` · ${relatedItem.object.constellation}`}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    <!-- Fullscreen Gallery -->
    <FullscreenGallery items={galleryData} currentIndex={currentIndex} base={base} />

    <script src="../../scripts/init-fullscreen.ts"></script>
  </body>
</html>
