---
import galleryData from '../data/gallery.json';
const base = import.meta.env.BASE_URL;

// Full URLs for Open Graph
const siteUrl = 'https://purikv.github.io';
const pageUrl = `${siteUrl}${base}/`;
const description = "Колекція астрофотографій глибокого космосу - галактики, туманності та зоряні скупчення";
// Use first image from gallery as preview (800px for faster loading)
// URL-encode the image path to handle Cyrillic characters
const firstImage = galleryData[0]?.preview
  ? `${siteUrl}${base}/${galleryData[0].preview.split('/').map(encodeURIComponent).join('/')}`
  : `${siteUrl}${base}/thumbnails/default_800.jpg`;
---
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Astro Gallery - Астрофотографія</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content="Astro Gallery - Астрофотографія" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={firstImage} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="533" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content="Astro Gallery - Володимир Пурик" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content="Astro Gallery - Астрофотографія" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={firstImage} />

    <!-- Additional meta -->
    <meta name="author" content="Володимир Пурик" />
    <link rel="canonical" href={pageUrl} />
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        margin: 0;
        padding: 1rem;
        background: #000;
        color: #e0e0e0;
        line-height: 1.5;
      }

      /* Header */
      .header {
        max-width: 1400px;
        margin: 0 auto 2rem;
        padding: 0 1rem;
      }

      h1 {
        color: #fff;
        text-align: center;
        margin: 0 0 0.5rem 0;
        font-size: 1.75rem;
        font-weight: 300;
        letter-spacing: 0.02em;
      }

      .subtitle {
        text-align: center;
        color: #666;
        font-size: 0.85rem;
        margin: 0;
        font-weight: 300;
        letter-spacing: 0.03em;
      }

      @media (min-width: 768px) {
        .header {
          margin-bottom: 4rem;
        }

        h1 {
          font-size: 2.25rem;
        }

        .subtitle {
          font-size: 0.9rem;
        }
      }

      /* Gallery Grid */
      .gallery {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        max-width: 1400px;
        margin: 0 auto;
      }

      @media (min-width: 640px) {
        body { padding: 1.5rem; }
        .gallery {
          grid-template-columns: repeat(2, 1fr);
          gap: 2rem;
        }
      }

      @media (min-width: 1024px) {
        body { padding: 2rem; }
        .gallery {
          grid-template-columns: repeat(3, 1fr);
          gap: 2rem;
        }
      }

      /* Card Styles - Clean & Minimal */
      .gallery-card {
        background: #000;
        border: 1px solid rgba(255, 255, 255, 0.05);
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        text-decoration: none;
        color: inherit;
        display: block;
      }

      .gallery-card:hover {
        border-color: rgba(255, 255, 255, 0.15);
        transform: translateY(-8px);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
      }

      .card-image-wrapper {
        position: relative;
        overflow: hidden;
        aspect-ratio: 4/3;
        background: #000;
      }

      .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
      }

      .gallery-card:hover .card-image {
        transform: scale(1.08);
        opacity: 0.85;
      }

      .card-content {
        padding: 1.25rem;
      }

      @media (min-width: 768px) {
        .card-content {
          padding: 1.5rem;
        }
      }

      .card-title {
        font-size: 1.25rem;
        font-weight: 400;
        margin: 0 0 0.75rem 0;
        color: #fff;
        letter-spacing: 0.02em;
      }

      @media (min-width: 768px) {
        .card-title {
          font-size: 1.3rem;
        }
      }

      .card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .meta-tag {
        background: transparent;
        padding: 0.25rem 0.65rem;
        font-size: 0.7rem;
        color: #888;
        border: 1px solid #2a2a2a;
        white-space: nowrap;
        font-weight: 300;
        letter-spacing: 0.03em;
      }

      .meta-tag.primary {
        color: #ccc;
        border-color: #444;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>Астрофотографія</h1>
      <p class="subtitle">Глибокий космос очима любителя</p>
    </div>

    <div class="gallery">
      {galleryData.map((item) => (
        <a href={`${base}/object/${item.object.id}`} class="gallery-card">
          {item.preview && (
            <div class="card-image-wrapper">
              <img
                src={`${base}/${item.preview}`}
                alt={item.object?.name || item.title}
                loading="lazy"
                class="card-image"
              />
            </div>
          )}

          <div class="card-content">
            <h2 class="card-title">{item.object?.name || item.title}</h2>

            <div class="card-meta">
              {item.object?.type && <span class="meta-tag primary">{item.object.type}</span>}
              {item.object?.constellation && <span class="meta-tag">{item.object.constellation}</span>}
              {item.object?.distance_ly && (
                <span class="meta-tag">{item.object.distance_ly.toLocaleString('uk-UA')} св.р.</span>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </body>
</html>
