---
import galleryData from '../data/gallery.json';
import StarField from '../components/effects/StarField.astro';
import ParticleEffect from '../components/effects/ParticleEffect.astro';
import ThemeProvider from '../components/theme/ThemeProvider.astro';
import ThemeSwitcher from '../components/theme/ThemeSwitcher.astro';
import GalleryCard from '../components/gallery/GalleryCard.astro';
import SearchBar from '../components/ui/SearchBar.astro';
import FilterPanel from '../components/ui/FilterPanel.astro';
import SortOptions from '../components/ui/SortOptions.astro';
import '../styles/global.css';
import '../styles/animations.css';
import '../styles/effects.css';

const base = import.meta.env.BASE_URL;

// Full URLs for Open Graph
const siteUrl = 'https://purikv.github.io';
const pageUrl = `${siteUrl}${base}/`;
const description = "Колекція астрофотографій глибокого космосу - галактики, туманності та зоряні скупчення";
// Use first image from gallery as preview (800px for faster loading)
// URL-encode the image path to handle Cyrillic characters
const firstImage = galleryData[0]?.preview
  ? `${siteUrl}${base}/${galleryData[0].preview.split('/').map(encodeURIComponent).join('/')}`
  : `${siteUrl}${base}/thumbnails/default_800.jpg`;
---
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Astro Gallery - Астрофотографія</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content="Astro Gallery - Астрофотографія" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={firstImage} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="533" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content="Astro Gallery - Володимир Пурик" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content="Astro Gallery - Астрофотографія" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={firstImage} />

    <!-- Additional meta -->
    <meta name="author" content="Володимир Пурик" />
    <link rel="canonical" href={pageUrl} />
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        margin: 0;
        padding: 1rem;
        background: #000;
        color: #e0e0e0;
        line-height: 1.5;
      }

      /* Header */
      .header {
        max-width: 1400px;
        margin: 0 auto 2rem;
        padding: 0 1rem;
      }

      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
      }

      /* Controls Container */
      .controls-container {
        max-width: 1400px;
        margin: 0 auto 2rem;
        padding: 0 1rem;
      }

      .controls-row {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        align-items: center;
      }

      @media (max-width: 768px) {
        .controls-row {
          flex-direction: column;
          align-items: stretch;
        }
      }

      /* Empty State */
      .empty-state {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 400px;
        padding: 4rem 2rem;
      }

      .empty-state-content {
        text-align: center;
        color: var(--color-text-tertiary);
      }

      .empty-state-content svg {
        margin-bottom: 1.5rem;
        opacity: 0.5;
      }

      .empty-state-content p {
        font-size: 1.25rem;
        margin-bottom: 1.5rem;
      }

      .reset-button {
        padding: 0.75rem 1.5rem;
        background: var(--color-primary);
        color: white;
        border: none;
        border-radius: var(--radius-full);
        font-size: 0.9rem;
        cursor: pointer;
        transition: all var(--transition-base);
      }

      .reset-button:hover {
        transform: translateY(-2px);
        box-shadow: var(--glow-md);
      }

      h1 {
        color: #fff;
        text-align: center;
        margin: 0 0 0.5rem 0;
        font-size: 1.75rem;
        font-weight: 300;
        letter-spacing: 0.02em;
      }

      .subtitle {
        text-align: center;
        color: #666;
        font-size: 0.85rem;
        margin: 0;
        font-weight: 300;
        letter-spacing: 0.03em;
      }

      @media (min-width: 768px) {
        .header {
          margin-bottom: 4rem;
        }

        h1 {
          font-size: 2.25rem;
        }

        .subtitle {
          font-size: 0.9rem;
        }
      }

      /* Gallery Grid */
      .gallery {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        max-width: 1400px;
        margin: 0 auto;
      }

      @media (min-width: 640px) {
        body { padding: 1.5rem; }
        .gallery {
          grid-template-columns: repeat(2, 1fr);
          gap: 2rem;
        }
      }

      @media (min-width: 1024px) {
        body { padding: 2rem; }
        .gallery {
          grid-template-columns: repeat(3, 1fr);
          gap: 2rem;
        }
      }

      /* Gallery-specific styles */
    </style>
  </head>
  <body>
    <ThemeProvider />
    <StarField />
    <ParticleEffect count={15} />

    <div class="header">
      <div class="header-content">
        <div>
          <h1>Астрофотографія</h1>
          <p class="subtitle">Глибокий космос очима любителя</p>
        </div>
        <ThemeSwitcher />
      </div>
    </div>

    <div class="controls-container">
      <div class="controls-row">
        <SearchBar />
        <SortOptions />
      </div>
      <FilterPanel />
    </div>

    <div class="gallery">
      {galleryData.map((item, index) => (
        <GalleryCard item={item} base={base} index={index} />
      ))}
    </div>

    <script src="../scripts/gallery-filter.ts"></script>
  </body>
</html>
